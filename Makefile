CXX := aarch64-linux-gnu-g++
TARGET := th06
BUILD := build-arm64

CXXFLAGS := -std=c++20 -O2 -Isrc -I/usr/include/SDL2 -D_REENTRANT \
            -DLIBASOUND_MIDI_SUPPORT \
            -Wall -Wextra -Wpedantic -fjump-tables \
            -fno-strict-aliasing
LDFLAGS := -L/usr/lib/aarch64-linux-gnu
LDLIBS := -lSDL2 -lSDL2_image -lSDL2_ttf -lasound -lm -lstdc++ -lpthread

SRCS := $(filter-out src/main.cpp,$(wildcard src/*.cpp)) \
        src/graphics/GLFunc.cpp \
        src/graphics/FixedFunctionGL.cpp \
        src/graphics/WebGL.cpp \
        src/graphics/Software.cpp \
        src/pbg3/FileAbstraction.cpp \
        src/pbg3/IPbg3Parser.cpp \
        src/pbg3/Pbg3Archive.cpp \
        src/pbg3/Pbg3Parser.cpp \
        src/thirdparty/sjis_converter.cpp \
        src/midi/MidiAlsa.cpp
OBJS := $(patsubst %.cpp,$(BUILD)/%.o,$(SRCS))

all: $(TARGET)

$(BUILD)/%.o: %.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(TARGET): $(OBJS) $(BUILD)/main.o
	$(CXX) $(CXXFLAGS) $(LDFLAGS) $(OBJS) $(BUILD)/main.o -o $@ $(LDLIBS)

$(BUILD)/main.o: src/main.cpp src/autogenerated/Embeds.hpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c $< -o $@

src/autogenerated/Embeds.hpp: tools/gen_embeds.py src/graphics/ff.vert src/graphics/ff.frag
	python3 tools/gen_embeds.py

clean:
	rm -rf $(BUILD) $(TARGET)

.PHONY: all clean
